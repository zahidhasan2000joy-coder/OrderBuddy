rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
             'email' in request.auth.token &&
             request.auth.token.email == 'zahidhasan2000joy@gmail.com' &&
             'email_verified' in request.auth.token &&
             request.auth.token.email_verified == true;
    }

    function isAppEnabled() {
      return !exists(/databases/$(database)/documents/app_config/global) ||
             get(/databases/$(database)/documents/app_config/global).data.get('appEnabled', true) == true;
    }

    function isValidAppConfig(data) {
      return data.keys().hasOnly(['appEnabled', 'coinFeatureEnabled', 'defaultNoticesSeeded']) &&
             (!('appEnabled' in data) || data.appEnabled is bool) &&
             (!('coinFeatureEnabled' in data) || data.coinFeatureEnabled is bool) &&
             (!('defaultNoticesSeeded' in data) || data.defaultNoticesSeeded is bool);
    }

    function hasAllowedUserKeys(data) {
      return data.keys().hasOnly([
        'uid', 'email', 'displayName', 'numericId',
        'connectedPartnerId', 'connectedPartnerUid', 'connectedPartnerName',
        'coins', 'lastCoinDate', 'createdAt',
        'profilePhotoData', 'birthday', 'profession', 'address',
        'lastProfileEditMonth', 'lastProfileEditAtMs'
      ]);
    }

    function hasValidExtendedProfileFields(data) {
      return (!('profilePhotoData' in data) || (
               data.profilePhotoData is string &&
               (data.profilePhotoData == '' ||
                (data.profilePhotoData.size() <= 210000 &&
                 ((data.profilePhotoData.size() >= 23 && data.profilePhotoData[0:23] == 'data:image/webp;base64,') ||
                  (data.profilePhotoData.size() >= 23 && data.profilePhotoData[0:23] == 'data:image/jpeg;base64,') ||
                  (data.profilePhotoData.size() >= 22 && data.profilePhotoData[0:22] == 'data:image/png;base64,'))))
             )) &&
             (!('birthday' in data) || (
               data.birthday is string &&
               (data.birthday == '' || data.birthday.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
             )) &&
             (!('profession' in data) || (data.profession is string && data.profession.size() <= 60)) &&
             (!('address' in data) || (data.address is string && data.address.size() <= 200)) &&
             (!('lastProfileEditMonth' in data) || (
               data.lastProfileEditMonth is string &&
               (data.lastProfileEditMonth == '' || data.lastProfileEditMonth.matches('^20[0-9]{2}-(0[1-9]|1[0-2])$'))
             )) &&
             (!('lastProfileEditAtMs' in data) || (
               data.lastProfileEditAtMs is int &&
               data.lastProfileEditAtMs >= 0 &&
               data.lastProfileEditAtMs <= 4102444800000
             ));
    }

    function didExtendedProfileChange(newData, oldData) {
      return newData.get('profilePhotoData', '') != oldData.get('profilePhotoData', '') ||
             newData.get('birthday', '') != oldData.get('birthday', '') ||
             newData.get('profession', '') != oldData.get('profession', '') ||
             newData.get('address', '') != oldData.get('address', '');
    }

    function isLegacyPhotoToWebpUpgrade(newData, oldData) {
      return oldData.get('profilePhotoData', '') != '' &&
             !(oldData.get('profilePhotoData', '').size() >= 23 &&
               oldData.get('profilePhotoData', '')[0:23] == 'data:image/webp;base64,') &&
             newData.get('profilePhotoData', '').size() >= 23 &&
             newData.get('profilePhotoData', '')[0:23] == 'data:image/webp;base64,' &&
             newData.get('birthday', '') == oldData.get('birthday', '') &&
             newData.get('profession', '') == oldData.get('profession', '') &&
             newData.get('address', '') == oldData.get('address', '');
    }

    function tsYearMonth(ts) {
      return string(ts.year()) + '-' + (ts.month() < 10 ? '0' + string(ts.month()) : string(ts.month()));
    }

    function isValidCurrentMonthString(monthStr) {
      return monthStr == tsYearMonth(request.time) ||
             monthStr == tsYearMonth(request.time - duration.value(12, 'h')) ||
             monthStr == tsYearMonth(request.time + duration.value(14, 'h'));
    }

    function isValidUserCreate(data, docNumericId) {
      return hasAllowedUserKeys(data) &&
             hasValidExtendedProfileFields(data) &&
             data.uid is string &&
             data.uid == request.auth.uid &&
             data.numericId is string &&
             data.numericId.size() >= 5 &&
             data.numericId.size() <= 12 &&
             data.numericId == docNumericId &&
             (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120)) &&
             (!('connectedPartnerId' in data) || (data.connectedPartnerId is string && data.connectedPartnerId.size() <= 12)) &&
             (!('connectedPartnerUid' in data) || (data.connectedPartnerUid is string && data.connectedPartnerUid.size() <= 128)) &&
             (!('connectedPartnerName' in data) || (data.connectedPartnerName is string && data.connectedPartnerName.size() <= 120)) &&
             (!('lastCoinDate' in data) || (data.lastCoinDate is string && data.lastCoinDate.size() <= 10)) &&
             (!('lastProfileEditMonth' in data) || data.lastProfileEditMonth == '') &&
             (!('lastProfileEditAtMs' in data) || data.lastProfileEditAtMs == 0) &&
             (!('coins' in data) || (data.coins is int && (isAdmin() || data.coins == 0)));
    }

    function isValidUserUpdate(newData, oldData) {
      return hasAllowedUserKeys(newData) &&
             hasValidExtendedProfileFields(newData) &&
             newData.uid is string &&
             newData.uid == oldData.uid &&
             newData.numericId is string &&
             newData.numericId == oldData.numericId &&
             (!('email' in newData) || (newData.email is string && newData.email.size() <= 150)) &&
             (!('displayName' in newData) || (newData.displayName is string && newData.displayName.size() <= 120)) &&
             (!('connectedPartnerId' in newData) || (newData.connectedPartnerId is string && newData.connectedPartnerId.size() <= 12)) &&
             (!('connectedPartnerUid' in newData) || (newData.connectedPartnerUid is string && newData.connectedPartnerUid.size() <= 128)) &&
             (!('connectedPartnerName' in newData) || (newData.connectedPartnerName is string && newData.connectedPartnerName.size() <= 120)) &&
             (!('lastCoinDate' in newData) || (newData.lastCoinDate is string && newData.lastCoinDate.size() <= 10)) &&
             (!('coins' in newData) || isAdmin() || (
               newData.coins is int &&
               newData.coins >= 0 &&
               newData.coins <= 100000 &&
               (
                 (!('coins' in oldData) && newData.coins <= 1) ||
                 ('coins' in oldData && newData.coins == oldData.coins) ||
                 ('coins' in oldData &&
                  newData.coins == oldData.coins + 1 &&
                  'lastCoinDate' in newData &&
                  newData.lastCoinDate is string &&
                  newData.lastCoinDate.size() == 10 &&
                  (!('lastCoinDate' in oldData) || newData.lastCoinDate != oldData.lastCoinDate))
               )
             )) &&
             (isAdmin() || (
               didExtendedProfileChange(newData, oldData)
                 ? ('lastProfileEditMonth' in newData &&
                    newData.lastProfileEditMonth is string &&
                    isValidCurrentMonthString(newData.lastProfileEditMonth) &&
                    (newData.lastProfileEditMonth != oldData.get('lastProfileEditMonth', '') ||
                     isLegacyPhotoToWebpUpgrade(newData, oldData)))
                 : newData.get('lastProfileEditMonth', '') == oldData.get('lastProfileEditMonth', '')
             ));
    }

    function isValidOrder(data) {
      return data.keys().hasOnly([
               'orderNumber', 'userId', 'userName', 'buddyId', 'partnerName',
               'status', 'items', 'totalCost', 'formattedDate', 'formattedTime',
               'purchaseMarketName', 'createdAtMs', 'acceptedAtMs',
               'shoppingDurationMinutes', 'shoppingDeadlineMs',
               'rejectionReason', 'incompleteReason', 'createdAt', 'updatedAt'
             ]) &&
             data.userId is string &&
             data.userId.size() > 0 &&
             data.userId.size() <= 128 &&
             data.buddyId is string &&
             data.buddyId.size() <= 128 &&
             (!('orderNumber' in data) || (data.orderNumber is string && data.orderNumber.size() <= 40)) &&
             (!('userName' in data) || (data.userName is string && data.userName.size() <= 120)) &&
             (!('partnerName' in data) || (data.partnerName is string && data.partnerName.size() <= 120)) &&
             (!('formattedDate' in data) || (data.formattedDate is string && data.formattedDate.size() <= 40)) &&
             (!('formattedTime' in data) || (data.formattedTime is string && data.formattedTime.size() <= 40)) &&
             (!('purchaseMarketName' in data) || (data.purchaseMarketName is string && data.purchaseMarketName.size() <= 120)) &&
             data.status is string &&
             data.status in ['pending', 'accepted', 'completed', 'cancelled', 'rejected', 'expired', 'incomplete'] &&
             data.items is list &&
             data.items.size() >= 1 &&
             data.items.size() <= 25 &&
             data.items[0] is map &&
             (data.totalCost is int || data.totalCost is float) &&
             data.totalCost >= 0 &&
             data.totalCost <= 10000000 &&
             (!('createdAtMs' in data) || (data.createdAtMs is int && data.createdAtMs >= 0 && data.createdAtMs <= 4102444800000)) &&
             (!('acceptedAtMs' in data) || (data.acceptedAtMs is int && data.acceptedAtMs >= 0 && data.acceptedAtMs <= 4102444800000)) &&
             (!('shoppingDurationMinutes' in data) || (data.shoppingDurationMinutes is int && data.shoppingDurationMinutes >= 0 && data.shoppingDurationMinutes <= 1440)) &&
             (!('shoppingDeadlineMs' in data) || (data.shoppingDeadlineMs is int && data.shoppingDeadlineMs >= 0 && data.shoppingDeadlineMs <= 4102444800000)) &&
             (!('rejectionReason' in data) || (data.rejectionReason is string && data.rejectionReason.size() <= 300)) &&
             (!('incompleteReason' in data) || (data.incompleteReason is string && data.incompleteReason.size() <= 300));
    }

    function hasAllowedNotificationKeys(data) {
      return data.keys().hasOnly([
        'targetUid', 'title', 'message', 'type', 'orderId',
        'senderNumericId', 'senderUid', 'senderName', 'createdAt', 'updatedAt'
      ]);
    }

    function isValidNotificationCreate(data) {
      return hasAllowedNotificationKeys(data) &&
             data.targetUid is string &&
             data.targetUid.size() > 0 &&
             data.targetUid.size() <= 128 &&
             data.title is string &&
             data.title.size() > 0 &&
             data.title.size() <= 150 &&
             data.message is string &&
             data.message.size() > 0 &&
             data.message.size() <= 600 &&
             data.type is string &&
             data.type in [
               'partner_connected', 'new_order', 'order_accepted', 'order_completed',
               'order_rejected', 'order_incomplete', 'item_unavailable',
               'admin_broadcast', 'admin_message', 'info'
             ] &&
             (!('orderId' in data) || (data.orderId is string && data.orderId.size() <= 128)) &&
             (!('senderNumericId' in data) || (data.senderNumericId is string && data.senderNumericId.size() <= 12)) &&
             (!('senderUid' in data) || (data.senderUid is string && data.senderUid.size() <= 128)) &&
             (!('senderName' in data) || (data.senderName is string && data.senderName.size() <= 120)) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             (isAdmin() || (
               data.targetUid != 'ALL' &&
               data.type in [
                 'partner_connected', 'new_order', 'order_accepted', 'order_completed',
                 'order_rejected', 'order_incomplete', 'item_unavailable'
               ]
             ));
    }

    function isValidMarketPurchaseFields(data) {
      return data.keys().hasOnly([
               'userId', 'orderId', 'orderNumber', 'requesterId', 'itemName',
               'quantity', 'notes', 'boughtPrice', 'productUrl', 'marketSource',
               'marketName', 'formattedDate', 'formattedTime', 'createdAt'
             ]) &&
             data.userId is string &&
             data.userId.size() > 0 &&
             data.userId.size() <= 128 &&
             data.orderId is string &&
             data.orderId.size() > 0 &&
             data.orderId.size() <= 128 &&
             (!('orderNumber' in data) || (data.orderNumber is string && data.orderNumber.size() <= 40)) &&
             (!('requesterId' in data) || (data.requesterId is string && data.requesterId.size() <= 128)) &&
             data.itemName is string &&
             data.itemName.size() > 0 &&
             data.itemName.size() <= 120 &&
             (!('quantity' in data) || (data.quantity is int && data.quantity >= 1 && data.quantity <= 1000)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 250)) &&
             (!('productUrl' in data) || (data.productUrl is string && data.productUrl.size() <= 500)) &&
             (data.boughtPrice is int || data.boughtPrice is float) &&
             data.boughtPrice >= 0 &&
             data.boughtPrice <= 1000000 &&
             data.marketSource is string &&
             data.marketSource in ['manual', 'online', 'offline'] &&
             data.marketName is string &&
             data.marketName.size() > 0 &&
             data.marketName.size() <= 120 &&
             (!('formattedDate' in data) || (data.formattedDate is string && data.formattedDate.size() <= 40)) &&
             (!('formattedTime' in data) || (data.formattedTime is string && data.formattedTime.size() <= 40)) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time;
    }

    function isValidGiftClaim(data) {
      return data.keys().hasOnly([
               'userId', 'userNumericId', 'userEmail', 'userName', 'coins',
               'recipientName', 'phone', 'address', 'note', 'status',
               'createdAt', 'updatedAt'
             ]) &&
             data.userId is string &&
             data.userId.size() > 0 &&
             data.userId.size() <= 128 &&
             data.userNumericId is string &&
             data.userNumericId.size() >= 5 &&
             data.userNumericId.size() <= 12 &&
             (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 150)) &&
             (!('userName' in data) || (data.userName is string && data.userName.size() <= 120)) &&
             data.coins is int &&
             data.coins >= 180 &&
             data.coins <= 100000 &&
             data.recipientName is string &&
             data.recipientName.size() >= 2 &&
             data.recipientName.size() <= 80 &&
             data.phone is string &&
             data.phone.size() >= 6 &&
             data.phone.size() <= 20 &&
             data.address is string &&
             data.address.size() >= 5 &&
             data.address.size() <= 300 &&
             (!('note' in data) || (data.note is string && data.note.size() <= 200)) &&
             data.status is string &&
             data.status in ['pending', 'approved', 'delivered'] &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    // Users Collection (keyed by numericId)
    match /users/{numericId} {
      allow get: if isSignedIn() && (isAdmin() || isAppEnabled());
      allow list: if isSignedIn();
      allow create: if isSignedIn() &&
                       (isAdmin() || isAppEnabled()) &&
                       isValidUserCreate(request.resource.data, numericId);
      allow update: if isSignedIn() &&
                       (isAdmin() || isAppEnabled()) &&
                       isValidUserUpdate(request.resource.data, resource.data) &&
                       (isAdmin() || resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Orders Collection (shared between order creator and assigned buddy, plus full Admin access)
    match /orders/{orderId} {
      allow get: if isSignedIn() &&
                    (isAdmin() ||
                     (isAppEnabled() &&
                      (resource.data.userId == request.auth.uid ||
                       resource.data.buddyId == request.auth.uid)));
      allow list: if isSignedIn() &&
                     (isAdmin() ||
                      resource.data.userId == request.auth.uid ||
                      resource.data.buddyId == request.auth.uid);
      allow create: if isSignedIn() &&
                       (isAdmin() || isAppEnabled()) &&
                       isValidOrder(request.resource.data) &&
                       (isAdmin() || request.resource.data.userId == request.auth.uid);
      allow update: if isSignedIn() &&
                       (isAdmin() || isAppEnabled()) &&
                       isValidOrder(request.resource.data) &&
                       (isAdmin() ||
                        ((resource.data.userId == request.auth.uid ||
                          resource.data.buddyId == request.auth.uid) &&
                         request.resource.data.userId == resource.data.userId));
      allow delete: if isSignedIn() &&
                       (isAdmin() ||
                        (isAppEnabled() &&
                         (resource.data.userId == request.auth.uid ||
                          resource.data.buddyId == request.auth.uid)));
    }

    // Notifications Collection (targeted to recipient UID or Admin-only broadcast 'ALL')
    match /notifications/{notificationId} {
      allow get: if isSignedIn() && (isAdmin() || (isAppEnabled() && (resource.data.targetUid == request.auth.uid || resource.data.targetUid == 'ALL')));
      allow list: if isSignedIn() && (isAdmin() || resource.data.targetUid == request.auth.uid || resource.data.targetUid == 'ALL');
      allow delete: if isSignedIn() && (isAdmin() || (isAppEnabled() && resource.data.targetUid == request.auth.uid));
      allow create: if isSignedIn() && (isAdmin() || isAppEnabled()) && isValidNotificationCreate(request.resource.data);
      allow update: if isAdmin() &&
                       hasAllowedNotificationKeys(request.resource.data) &&
                       request.resource.data.title is string &&
                       request.resource.data.title.size() > 0 &&
                       request.resource.data.title.size() <= 150 &&
                       request.resource.data.message is string &&
                       request.resource.data.message.size() > 0 &&
                       request.resource.data.message.size() <= 600;
    }

    // Market Purchases Collection (server-side purchase market log owned by buyer, plus Admin control)
    match /market_purchases/{purchaseId} {
      allow get: if isSignedIn() && (isAdmin() || (isAppEnabled() && resource.data.userId == request.auth.uid));
      allow list: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow delete: if isSignedIn() && (isAdmin() || (isAppEnabled() && resource.data.userId == request.auth.uid));
      allow create: if isSignedIn() &&
                       (isAdmin() || isAppEnabled()) &&
                       isValidMarketPurchaseFields(request.resource.data) &&
                       (isAdmin() || request.resource.data.userId == request.auth.uid);
      allow update: if isSignedIn() &&
                       (isAdmin() || isAppEnabled()) &&
                       isValidMarketPurchaseFields(request.resource.data) &&
                       (isAdmin() ||
                        (resource.data.userId == request.auth.uid &&
                         request.resource.data.userId == resource.data.userId));
    }

    // Gift Claims Collection (180+ coins delivery address claims: strictly private to owner & Admin)
    match /gift_claims/{claimUserId} {
      allow get: if isSignedIn() && (isAdmin() || (isAppEnabled() && request.auth.uid == claimUserId));
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                       (isAdmin() || isAppEnabled()) &&
                       isValidGiftClaim(request.resource.data) &&
                       ((request.auth.uid == claimUserId &&
                         request.resource.data.userId == request.auth.uid &&
                         request.resource.data.status == 'pending' &&
                         get(/databases/$(database)/documents/users/$(request.resource.data.userNumericId)).data.uid == request.auth.uid &&
                         get(/databases/$(database)/documents/users/$(request.resource.data.userNumericId)).data.coins >= 180) ||
                        isAdmin());
      allow update: if isSignedIn() &&
                       (isAdmin() || isAppEnabled()) &&
                       isValidGiftClaim(request.resource.data) &&
                       request.resource.data.userId == resource.data.userId &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       ((request.auth.uid == claimUserId &&
                         request.resource.data.status == resource.data.status) ||
                        isAdmin());
      allow delete: if isAdmin();
    }

    // App Config Collection (admin toggles like appEnabled and coinFeatureEnabled)
    match /app_config/{configId} {
      allow get: if isSignedIn() || configId == 'global';
      allow list: if isSignedIn();
      allow create, update: if isAdmin() && isValidAppConfig(request.resource.data);
      allow delete: if isAdmin();
    }
  }
}
